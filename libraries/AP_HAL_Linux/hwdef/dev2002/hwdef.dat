# IMUs:
IMU Invensense SPI:mpu6500 ROTATION_YAW_270
#IMU Invensense I2C:3:0x68 ROTATION_YAW_270
define INS_MAX_INSTANCES 3

# Compasses:
#COMPASS AK8963:probe_mpu9250 0 ROTATION_NONE
define HAL_PROBE_EXTERNAL_I2C_COMPASSES 1

# Baros:
BARO BMP280 I2C:0:0x76

#define DEFAULT_NTF_LED_TYPES (Notify_LED_Board)
#define AP_NOTIFY_GPIO_LED_3_ENABLED 1
#define HAL_GPIO_A_LED_PIN        24
#define HAL_GPIO_B_LED_PIN        25
#define HAL_GPIO_C_LED_PIN        16

#            NAME      BUS SUBDEV MODE       BPW CS_PIN         LOWSPD HIGHSPD
LINUX_SPIDEV "mpu6500" 0   0      SPI_MODE_0 8   SPI_CS_KERNEL  1*MHZ  10*MHZ
LINUX_SPIDEV "iomcu_b" 0   1      SPI_MODE_0 8   SPI_CS_KERNEL  1*MHZ  10*MHZ

define MAG_BOARD_ORIENTATION ROTATION_YAW_270

// FIXME: use of this define should go away:
define CONFIG_HAL_BOARD_SUBTYPE HAL_BOARD_SUBTYPE_LINUX_DEV2002

define HAL_IOMCU_B "iomcu_b"
